# The docker image name you build with:
# docker build -t frappe-erpnext-v15:latest .
CUSTOM_IMAGE=frappe-erpnext-v15
IMAGE_TAG=latest

# =============================================================================
# Frappe / ERPNext version — which major version to build. FRAPPE_BRANCH and
# ERPNEXT_BRANCH must match, and PYTHON_VERSION/NODE_VERSION must match the
# Frappe version being built:
#   version-14  ->  Python 3.10, Node 20
#   version-15  ->  Python 3.12, Node 22
#   version-16  ->  Python 3.14, Node 24
# scripts/setup.sh sets all four — plus CUSTOM_IMAGE above — from a single
# "Frappe/ERPNext version" prompt, so you don't need to edit these by hand
# unless you're doing a manual build. Keep NODE_VERSION >= 22.12.0 on the
# Node-22 line — some custom apps' frontend deps (e.g. @vitejs/plugin-react
# 5.x) require it and fail `yarn install` on anything lower.
# =============================================================================
FRAPPE_BRANCH=version-15
ERPNEXT_BRANCH=version-15
PYTHON_VERSION=3.12
NODE_VERSION=22.14.0

# Your Frappe site name — this becomes the site folder name
# AND the MariaDB database name. Use your actual domain.
FRAPPE_SITE_NAME=erp.mycompany.com
FRAPPE_SITE_NAME_HEADER=$$host

# project Name for docker compose file
COMPOSE_PROJECT_NAME=frappe

# MariaDB root password — used during bench new-site and healthcheck
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_PASSWORD=root@123

# App-level DB user — Frappe uses this for all DB operations
DB_USER=frappe
DB_PASSWORD=some_strong_app_password


# Gunicorn — defaults work for most setups
# Increase WORKERS if you have more than 2 CPU cores
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Host ports — only change if 8000 or 9000 are already in use
# These are what your host nginx proxy_pass points to
BACKEND_PORT=8000
SOCKETIO_PORT=9000

# REDIS URLs — these are used by Frappe to connect to Redis services
REDIS_CACHE=redis://redis_cache:6379
REDIS_QUEUE=redis://redis_queue:6379
REDIS_SOCKETIO=redis://redis_queue:6379

# =============================================================================
# Custom apps — fetched directly from git at image-build time.
# Format: "git_url|branch;git_url|branch;..." (branch may be left empty).
# Populated automatically by scripts/setup.sh; leave empty for none.
# =============================================================================
CUSTOM_APPS=

# =============================================================================
# Network
# =============================================================================
NETWORK_NAME=frappe-net

# =============================================================================
# Volume names — namespace these per bench (e.g. prefix with COMPOSE_PROJECT_NAME)
# when running more than one FrappeForge stack on the same host.
# =============================================================================

# Host directory the `sites` volume binds to — must be an ABSOLUTE path so
# host Nginx's `location /assets` alias (frappe-nginx.conf) can read
# <this>/assets directly. scripts/setup.sh fills this in and creates the
# directory automatically; set it by hand for a manual/multi-bench setup.
SITES_HOST_PATH=/absolute/path/to/FrappeForge/volumes/sites

VOLUME_SITES=frappe_v15_sites
VOLUME_LOGS=frappe_v15_logs
VOLUME_MARIADB=frappe_v15_mariadb
VOLUME_REDIS_CACHE=frappe_v15_redis_cache
VOLUME_REDIS_QUEUE=frappe_v15_redis_queue
